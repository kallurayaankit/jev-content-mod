# moderate.jev
from jevlang import ask_all

def evaluate_content(content_text):
    answers = ask_all(
        content_text,
        harm=["none", "low", "medium", "high", "critical"],
        category={
            "harassment":  "targets a person or group with abuse, threats, or slurs",
            "spam":        "promotional, repetitive, or deceptive commercial content",
            "misinformation": "false or misleading claims presented as fact",
            "violence":    "encourages, depicts, or threatens physical harm",
            "sexual":      "explicit adult content",
            "self_harm":   "encourages or depicts self-injury",
            "benign":      "no policy violation detected",
        },
        is_clear="Is this content unambiguous in its intent?",
        needs_human="Does this require human judgment to decide?",
    )
    return answers